{
  "name": "xiaoxiaoshuo",
  "displayName": "小小小说",
  "description": "输入地址或书名，在 VS Code 中搜索并阅读小说。",
  "version": "0.0.3",
  "publisher": "xiaoxiaoshuo",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yao-Hub/xiaoxiaoshuo.git"
  },
  "homepage": "https://github.com/yao-Hub/xiaoxiaoshuo#readme",
  "bugs": {
    "url": "https://github.com/yao-Hub/xiaoxiaoshuo/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "xiaoxiaoshuoSidebar",
          "title": "小小小说",
          "icon": "media/book.svg"
        }
      ]
    },
    "views": {
      "xiaoxiaoshuoSidebar": [
        {
          "id": "xiaoxiaoshuo.readerView",
          "name": "小小小说",
          "type": "webview",
          "icon": "media/book.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "xiaoxiaoshuo.open",
        "title": "小小小说: 打开地址或搜索书名",
        "category": "小小小说"
      }
    ],
    "keybindings": [
      {
        "command": "xiaoxiaoshuo.open",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "lint": "node scripts/check-syntax.js",
    "test": "npm run lint",
    "package:vsix": "npx @vscode/vsce package",
    "publish:marketplace": "npx @vscode/vsce publish"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  }
}
